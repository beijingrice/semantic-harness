# 使用 LM Studio 开启 Developer -> Start Server
LM_BASE_URL=http://127.0.0.1:1234/v1
# 必须填写 /v1/models 返回的准确 model id；网页也可以分别选择
LM_MODEL=qwen/qwen3.5-9b
LM_VERIFIER_MODEL=google/gemma-4-12b-qat
# 两个 model id 都应与服务实际提供的 ID 一致；生产 API 可完全不同。
LM_API_KEY=lm-studio
LM_TIMEOUT_SECONDS=180
LM_MAX_TOKENS=4096
# v0.2.8: if generation truncates / has no JSON content, at most ONE
# prompt-only alternate request, fully checked with the original Pydantic Schema.
LM_GENERATION_RECOVERY=true
# 开发组合：Qwen3.5-9B + Gemma 4 12B QAT；生产应按目标 API 能力配置
# 如果将来切到不支持 response_format=json_schema 的 backend，可设 false
LM_JSON_SCHEMA=true
MAX_KEYWORDS=30

# v0.2.7: all model-generated source references are immutable paragraph IDs.
# Legacy quote mode is available for reproducible A/B comparisons.
LM_EVIDENCE_MODE=paragraph
# One cohesive unit can contain a complete list; no forced atomic splitting.
# Historic A/B: proposition = v0.2.4 atomic prompt, legacy = v0.2.2 prompt.
LM_EXTRACTION_PROMPT=coarse
# Optional: only non-list suspicious gaps trigger audit; off avoids redundant calls.
LM_COVERAGE_AUDIT=false
# Only used for experimental proposition mode. Kept OFF in simple default.
LM_ATOMIC_REFINEMENT=false

# v0.2.9.2: PRE-generation conservative source anchoring. Works for either
# a single cohesive source clause per language, OR two clearly separable
# bilingual clauses on each side. Abandons shortcut on ambiguity (multiple
# paragraphs, exception/conditional links, directional negation, etc.).
# Matching, full-original independent review and deterministic guards remain.
# Turn off for exact historical A/B comparisons or if you observe missed facts.
LM_EXTRACTION_FAST_PATH=true
# For short single-paragraph sources that do not qualify for fast path,
# cap extraction generation. If that output is TRUNCATED, the single recovery
# request uses LM_MAX_TOKENS instead (retrying with the same cap rarely helps).
# Long/multi-paragraph sources still use LM_MAX_TOKENS.
LM_EXTRACTION_MAX_TOKENS=1536

# v0.2.9: one short source sentence favors ONE cohesive grounded claim,
# and pathological repeated claims are safely collapsed before matching.
# v0.2.7: reviewer receives ORIGINAL bilingual texts only;
# short sentences with persistently empty inventories use verbatim source-anchored units.
# No extra configuration switches required.

# extraction = 默认的提取 + 匹配 + 复核流程；
# direct_hardened = 实验性的整段双模型比较 + 固定疑点核查（保留完整段落）。
# 其余历史 direct 模式已在 v0.3.0 移除，可从 git tag v0.2.16 找回。
LM_PIPELINE=extraction

# v0.2.16 Backend Compatibility
# openai = /v1/chat/completions; custom adapter = importable module:Class
LM_BACKEND=openai
# 复核模型可接入另一地址/API/非 OpenAI Adapter（留空则共享主 Backend）
# LM_VERIFIER_BACKEND=openai
# LM_VERIFIER_BASE_URL=https://another-provider.example/v1
# LM_VERIFIER_API_KEY=some-other-key

# legacy: 按 LM_JSON_SCHEMA 的历史行为（默认）；on: 必须用原生 Schema;
# off: 只用 prompt JSON；auto: 原生先试，明确不支持时仅降级一次
LM_SCHEMA_MODE=legacy
# required: 和原版一样 GET /models 必须可用；optional: 有则校验，
# 不支持 /models 则略过；off: 完全不请求 /models
LM_MODEL_DISCOVERY=required
# 对于明确没有 GET /models 的云服务通常设置 off；
# 对于不支持结构化输出的 API 设置 LM_SCHEMA_MODE=off。
